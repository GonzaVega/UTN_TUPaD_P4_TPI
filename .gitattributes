# Normaliza finales de línea: LF en el repo
* text=auto

# Scripts de Gradle / shell / config: LF siempre
gradlew text eol=lf
*.gradle text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.properties text eol=lf

# Batch de Windows: CRLF en checkout
*.bat text eol=crlf

# Binarios
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
