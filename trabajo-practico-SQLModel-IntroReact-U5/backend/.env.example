# Cadena de conexión a PostgreSQL
# Opción 1: Conexión local por socket (Linux default sin contraseña requerida)
DATABASE_URL=postgresql+psycopg:///tp5_productos

# Opción 2: Conexión TCP con usuario y contraseña (entorno docente / Docker)
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tp5_productos
